{% extends 'base.html.twig' %}

{% block title %}Task{% endblock %}

{% block body %}
    <h1>Task</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ task.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ task.name }}</td>
            </tr>
            <tr>
                <th>Gender</th>
                <td>{{ task.gender }}</td>
            </tr>
            <tr>
                <th>Hobby</th>
                <td>{{ task.hobby ? task.hobby|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ task.image }}</td>
            </tr>
            <tr>
                <th>Role</th>
                <td>{{ task.role }}</td>
            </tr>
            
        </tbody>
    </table>

    <a href="{{ path('app_task_index') }}">back to list</a>

    <a href="{{ path('app_task_edit', {'id': task.id}) }}">edit</a>

    {{ include('task/_delete_form.html.twig') }}
{% endblock %}
