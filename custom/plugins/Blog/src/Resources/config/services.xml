<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
     <service id="Blog\Core\Content\Extension\ProductExtension">
            <tag name="shopware.entity.extension" />
        </service>

        
        <service id="Blog\Core\Content\BlogProductMapping\BlogProductMappingDefinition">
         <tag name="shopware.entity.definition" />
        </service>

          <service id="Blog\Core\Content\BlogCategoryMapping\BlogCategoryMappingDefinition">
         <tag name="shopware.entity.definition" />
        </service>

        <service id="Blog\Core\Content\Blog\BlogDefinition">
         <tag name="shopware.entity.definition" />
        </service>

         <service id="Blog\Core\Content\Blog\Aggregate\BlogTranslationDefinition">
            <tag name="shopware.entity.definition" entity="blog_translation" />
        </service>

          <service id="Blog\Core\Content\BlogCategory\Aggregate\BlogCategoryTranslationDefinition">
            <tag name="shopware.entity.definition" entity="blog_category_translation" />
        </service>

        <service id="Blog\Core\Content\BlogCategory\BlogCategoryDefinition">
         <tag name="shopware.entity.definition" />
        </service>
        <service id="Blog\Core\Content\Extension\LanguageExtension">
            <tag name="shopware.entity.extension" />
        </service>


    </services>
</container>