
{% block blog_category_list %}
<sw-page>
    <template #smart-bar-header>
        <h2>{{ $tc('blog-bundle.list.title') }}</h2>
    </template>
    {% block block_category_list_language_switch %}
         <template #language-switch>
      <sw-language-switch @on-change="onChangeLanguage" />
    </template>
    {% endblock %}
   
    {% block blog_category_list_actions %}
          <template #smart-bar-actions>
          {% block blog_category_list_smart_bar_actions %}
         <sw-button variant="primary" :routerLink="{ name:'blog.bundle.create'}">{{ $tc('blog-bundle.list.addButton') }}
         </sw-button>
        {% endblock %}

    </template>

    {% endblock %}
  
    <template #content>
        <sw-entity-listing
            v-if="blogCategories"
            :items="blogCategories"
            :columns="columns"
            :is-loading="isLoading"
            detail-route="blog.bundle.detail"
            allow-edit
            :repository="repository"

        />
    </template>
</sw-page>
{% endblock %}



 
