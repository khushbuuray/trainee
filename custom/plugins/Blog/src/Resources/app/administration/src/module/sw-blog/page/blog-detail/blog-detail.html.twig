{% block sw_blog_detail %}
<sw-page>

    {% block sw_blog_detail_content %}

        <template #language-switch>
      <sw-language-switch @on-change="onChangeLanguage" />
    </template>
    <template #content>
        <sw-card title="Create Blogs">
            <sw-container>
                {% block sw_blog_detail_base_info_field_name %}

                <sw-text-field
                    v-if="blog"
                    v-model:value="blog.name"
                    :label="$tc('sw-blog.general.name')"
                    :placeholder="$tc('sw-blog.general.placeholderName')"
                    name="name"
                    :error="blogNameError"
                    required
                    validation="required"

                />
                 {% endblock %}

                 <sw-textarea-field
                    v-if="blog"
                    v-model:value="blog.description"
                    :label="$tc('sw-blog.general.description')"
                    :placeholder="$tc('sw-blog.general.placeholderDescription')"
                    name="description"
                    :error="blogDescriptionError"
                    required
                    
                    
                />

                  <sw-switch-field
                    v-if="blog"
                    v-model:value="blog.active"
                    :label="$tc('sw-blog.general.active')"
                    name="active"
                    required                    
                />

                   <sw-entity-multi-select
                   v-if="blog"
                   v-model:value="blog.blogCategories"
                   entity-name="blog_category"
                   :criteria="categoryCriteria"
                   :entity-collection="blog.blogCategories"
                   :placeholder="$tc('sw-blog.general.placeholderCategories')"
                   :label="$tc('sw-blog.general.categories')"
                   name="blogCategories"
                   required
                   @update:entity-collection="onCategoryChange"
                >
                 </sw-entity-multi-select>


                <sw-datepicker
                    v-if="blog"
                    v-model="blog.release_date"
                    :label="$tc('sw-blog.general.releaseDate')"
                    name="release_date"
                    required
                    :show-timepicker="true"
                    :error="blogReleaseDateError"
                />

                   <sw-text-field
                    v-if="blog"
                    v-model:value="blog.author"
                    :label="$tc('sw-blog.general.author')"
                    :placeholder="$tc('sw-blog.general.placeholderAuthor')"
                    name="author"
                    :error="blogAuthorError"
                    required
                />            

               
                <sw-entity-multi-select
                 v-if="blog"
                 v-model:value="blog.products"
                 entity-name="product"
                 :criteria="productCriteria"
                 :entity-collection="blog.products"
                 :label="$tc('sw-blog.general.products')"
                 :placeholder="$tc('sw-blog.general.placeholderProducts')"
                 name="products"
                 @update:entity-collection="onProductChange"
                 required

                  /> 
                
            </sw-container>
        </sw-card>
    </template>
    {% endblock %}
   

    {% block sw_blog_detail_actions %}
    <template #smart-bar-actions>
        <sw-button
            :disabled="isLoading"
            @click="onCancel"
        >
            Cancel
        </sw-button>

        <sw-button-process
            :is-loading="isLoading"
            @click="onSave"
            variant="primary"
        >
        Save
        </sw-button-process>
    </template>
    {% endblock %}

</sw-page>
{% endblock %}



