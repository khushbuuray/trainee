{% block sw_blog_detail %}
<sw-page>

    {% block sw_blog_detail_content %}

        <template #language-switch>
      <sw-language-switch @on-change="onChangeLanguage" />
    </template>
    <template #content>
        <sw-card title="Create Blogs">
            <sw-container>
                <sw-text-field
                    v-if="blog"
                    v-model:value="blog.name"
                    label="Name"
                    placeholder="Name"
                    name="name"
                    {# validation="required" #}
                    required
                />

                 <sw-textarea-field
                    v-if="blog"
                    v-model:value="blog.description"
                    label="Description"
                    placeholder="Description"
                    name="description"
                    required
                    
                />

                  <sw-switch-field
                    v-if="blog"
                    v-model:value="blog.active"
                    label="Active"
                    placeholder="Active"
                    name="active"
                    required
                    
                />

                   <sw-entity-multi-select
                   v-if="blog"
                   v-model:value="blog.blogCategories"
                   entity-name="blog_category"
                   :criteria="categoryCriteria"
                   :entity-collection="blog.blogCategories"
                   :placeholder="$tc('Select categories')"
                   label="Categories"
                   name="blogCategories"
                   required
                   @update:entity-collection="onCategoryChange"
                >
                 </sw-entity-multi-select>


                <sw-datepicker
                    v-if="blog"
                    v-model="blog.release_date"
                    label="Release Date"
                    placeholder="Release Date"
                    name="release_date"
                    required
                    :show-timepicker="true"
                />

                   <sw-text-field
                    v-if="blog"
                    v-model:value="blog.author"
                    label="Author"
                    placeholder="Author"
                    name="author"
                    required
                />            

               
                <sw-entity-multi-select
                 v-if="blog"
                 v-model:value="blog.products"
                 entity-name="product"
                 :criteria="productCriteria"
                 :entity-collection="blog.products"
                 label="Products"
                 placeholder="Select products"
                 name="products"
                 @update:entity-collection="onProductChange"
                 required

                  /> 
                
            </sw-container>
        </sw-card>
    </template>
    {% endblock %}
   

    {% block sw_blog_detail_actions %}
    <template #smart-bar-actions>
        <sw-button
            :disabled="isLoading"
            @click="onCancel"
        >
            Cancel
        </sw-button>

        <sw-button-process
            :is-loading="isLoading"
            @click="onSave"
            variant="primary"
        >
        Save
        </sw-button-process>
    </template>
    {% endblock %}

</sw-page>
{% endblock %}



