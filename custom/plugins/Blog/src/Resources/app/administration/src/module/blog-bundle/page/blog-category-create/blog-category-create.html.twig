{% block blog_category_create %}
<sw-page>
<template #language-switch>
 <sw-language-switch/>
    </template>
    
    {% block blog_category_create_content %}
    <template #content>

        <sw-card title="Create Blog Category">
            <sw-form>

            <sw-container>
               {% block blog_category_create_base_info_field_name %}
                <sw-text-field
                    v-if="category"
                    v-model:value="category.name"
                    :label="$tc('blog-bundle.general.labelCategoryName')"
                    :placeholder="$tc('blog-bundle.general.placeholderCategoryName')"
                    name="name"
                    required
                    validation="required"
                    :error="categoryNameError"
                />
                {% endblock %}
            </sw-container>
           </sw-form>

        </sw-card>
    </template>
    {% endblock %}
   

    {% block blog_category_create_actions %}
    <template #smart-bar-actions>
        <sw-button
            :disabled="isLoading"
            @click="onCancel"
        >
            Cancel
        </sw-button>

        <sw-button-process
            :is-loading="isLoading"
            @click="onSave"
            variant="primary"
        >
            Save
        </sw-button-process>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}



