{% block blog_category_create %}
<sw-page>

    {# {% block blog_category_create_header %}
    <template #smart-bar-header>
        <h2>{{ placeholder(category, 'name', 'Create Blog Category') }}</h2>
    </template>
    {% endblock %} #}

    {% block blog_category_create_content %}
    <template #content>
        <sw-card title="Create Blog Category">
            <sw-container>
                <sw-text-field
                    v-model:value="category.name"
                    label="Category Name"
                    placeholder="Category Name"
                    name="name"
                    validation="required"
                    required
                />
            </sw-container>
        </sw-card>
    </template>
    {% endblock %}
    
     {# {% block blog_category_create_field_name %}
      <sw-text-field
          v-model:value="category.name"
          label="Category Name"
          placeholder="Category Name"
          name="name"
          validation="required"
          required
      />
      {% endblock %} #}

    {% block blog_category_create_actions %}
    <template #smart-bar-actions>
        <sw-button
            :disabled="isLoading"
            @click="onCancel"
        >
            Cancel
        </sw-button>

        <sw-button-process
            :is-loading="isLoading"
            @click="onSave"
            variant="primary"
        >
            Save
        </sw-button-process>
    </template>
    {% endblock %}

</sw-page>
{% endblock %}


