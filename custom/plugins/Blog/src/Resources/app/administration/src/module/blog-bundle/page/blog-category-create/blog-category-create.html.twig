{% block blog_category_create %}
<sw-page>
<template #language-switch>
 <sw-language-switch/>
    </template>
    
    {% block blog_category_create_content %}
    <template #content>
        <sw-card title="Create Blog Category">
            <sw-container>
                <sw-text-field
                    v-if="category"
                    v-model:value="category.name"
                    label="Category Name"
                    placeholder="Category Name"
                    name="name"
                    validation="required"
                    required
                />
            </sw-container>
        </sw-card>
    </template>
    {% endblock %}
   

    {% block blog_category_create_actions %}
    <template #smart-bar-actions>
        <sw-button
            :disabled="isLoading"
            @click="onCancel"
        >
            Cancel
        </sw-button>

        <sw-button-process
            :is-loading="isLoading"
            @click="onSave"
            variant="primary"
        >
            Save
        </sw-button-process>
    </template>
    {% endblock %}

</sw-page>
{% endblock %}



