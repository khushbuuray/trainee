{
    "name": "blog/blog",
    "description": "blog/blog",
    "type": "shopware-platform-plugin",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "shopware/core": "~6.6.0"
    },
    "extra": {
        "shopware-plugin-class": "Blog\\Blog",
        "label": {
            "de-DE": "Blog plugin",
            "en-GB": "Blog plugin"
        },
        "shopware-app-admin-entrypoints": {
        "js": [
            "Resources/app/administration/src/main.js"
        ]
    }
    },
     
    "autoload": {
        "psr-4": {
            "Blog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blog\\Tests\\": "tests/"
        }
    }
}
