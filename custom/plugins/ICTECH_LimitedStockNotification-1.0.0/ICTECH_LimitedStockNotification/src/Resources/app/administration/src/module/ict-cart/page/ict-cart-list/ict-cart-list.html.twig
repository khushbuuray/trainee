{% block ict_cart_list %}
    <sw-page class="ict-cart-list">
        {% block ict_cart_list_smart_bar_header %}
            <template #smart-bar-header>
                {% block ict_cart_list_smart_bar_header_title %}
                    <span class="ict-cart-smart-bar-header-title">
                        {% block ict_cart_list_smart_bar_header_title_text %}
                            {{ $tc('ict-cart.general.listTitle') }}
                        {% endblock %}
                    </span>
                {% endblock %}
            </template>
        {% endblock %}

        <template #content>
            {% block ict_cart_list_content %}
                <div class="ict-cart-list__content">
                    {% block ict_cart_list_grid %}
                        <sw-entity-listing v-if="entities"
                                           :items="entities"
                                           :columns="columns"
                                           :repository="repository"
                                           :showSelection="true"
                                           :isLoading="isLoading"
                                           @update-records="updateTotal">

                            {% block  ict_cart_list_content_column_lastMailSendAt %}        
                                <template slot="column-lastMailSendAt" slot-scope="{ item }">
                                    <span v-if="item.lastMailSendAt">
                                        {{ item.lastMailSendAt | date({hour: '2-digit', minute: '2-digit', second: '2-digit'}) }}
                                    </span>
                                    <span v-else>
                                    {{ $tc('ict-cart.list.placeholders.lastMailSendAtPlaceholder') }}
                                    </span>
                                </template>
                            {% endblock %}

                            {% block  ict_cart_list_content_column_createdAt %}
                                <template slot="column-createdAt" slot-scope="{ item }">
                                    {{ item.createdAt | date({hour: '2-digit', minute: '2-digit', second: '2-digit'}) }}
                                </template>
                            {% endblock %}

                            {% block  ict_cart_list_content_column_updatedAt %}
                                <template slot="column-updatedAt" slot-scope="{ item }">
                                    {{ item.updatedAt | date({hour: '2-digit', minute: '2-digit', second: '2-digit'}) }}
                                </template>
                            {% endblock %}

                            {% block  ict_cart_list_content_column_wishlistId %}
                                <template slot="column-wishlistId" slot-scope="{ item }">
                                    {{ item.wishlistId }}
                                </template>
                            {% endblock %}

                            {% block  ict_cart_list_content_more_actions %}    
                                <template slot="more-actions" slot-scope="{ item }">
                                    <sw-context-menu-item @click="onOpenDetailModel(item)"
                                                        :disabled="!item"
                                                        class="sw-entity-listing__context-menu-edit-open-details">
                                        {{ $tc('ict-cart.contextActions.openDetails') }}
                                    </sw-context-menu-item>
                                </template>
                            {% endblock %}
                        </sw-entity-listing>
                    {% endblock %}

                    {% block ict_cart_details_modal %}
                        <ict-cart-details-modal v-if="ictCartDetailsModalOpened"
                                                :ict-cart="ictCartDetailCart"
                                                :isLoading="isLoading"
                                                :onClose="onCloseIctCartDetailsModal">
                        </ict-cart-details-modal>
                    {% endblock %}

                    {% block ict_cart_list_empty_state %}
                        <sw-empty-state v-if="!isLoading && !total" 
                                        :title="$tc('ict-cart.list.messageEmpty')">
                        </sw-empty-state>
                    {% endblock %}
                </div>
            {% endblock %}
        </template>

        {% block ict_cart_list_sidebar %}
            <template #sidebar>
                <sw-sidebar>
                    {% block ict_cart_list_sidebar_refresh %}
                        <sw-sidebar-item
                                icon="regular-undo"
                                :title="$tc('ict-cart.general.titleSidebarItemRefresh')"
                                @click="onRefresh">
                        </sw-sidebar-item>
                    {% endblock %}
                </sw-sidebar>
            </template>
        {% endblock %}
    </sw-page>
{% endblock %}
