export default "{% block ict_cart_details_modal %}\n    {#for wishlist #}\n        <sw-modal\n                v-if=\"ictCart.lineItems === null\"\n                :title=\"$tc('ict-cart.detailsModal.wishlistModalTitle')\"\n                :isLoading=\"isLoading\"\n                @modal-close=\"onClose\">\n            {% block ict_cart_details_modal_line_items_grid %}\n                <sw-container type=\"row\" class=\"ict-cart-details-line-items-grid\">\n\n                    {% block ict_cart_details_modal_line_items_grid_grid %}\n                        <sw-data-grid :dataSource=\"items\"\n                                      :columns=\"getLineItemWishlistColumns\"\n                                      :fullPage=\"false\"\n                                      :showSettings=\"false\"\n                                      :showSelection=\"false\"\n                                      :showActions=\"true\"\n                                      :isLoading=\"isLoading\"\n                                      :allowColumnEdit=\"false\"\n                                      :allowInlineEdit=\"false\"\n                                      :compactMode=\"false\"\n                                      identifier=\"ict-cart-details-line-item-grid\"\n                                      class=\"\">\n\n                            {% block ict_cart_details_modal_line_items_grid_grid_columns %}\n                                {% block ict_cart_details_modal_line_items_grid_grid_columns_label %}\n                                    <template #column-label=\"{ item, isInlineEdit}\">\n                                        {% block ict_cart_details_modal_line_items_grid_grid_columns_label_content %}\n                                            <span>\n                                                {{ item.translated.name }}\n                                            </span>\n                                        {% endblock %}\n                                    </template>\n                                {% endblock %}\n\n                                {% block ict_cart_details_modal_line_items_grid_grid_columns_quantity %}\n                                    <template #column-quantity=\"{ item, isInlineEdit}\">\n                                        {% block ict_cart_details_modal_line_items_grid_grid_columns_quantity_content %}\n                                            <span>\n                                                {{ item.calculatedPrice.quantity }}\n                                            </span>\n                                        {% endblock %}\n                                    </template>\n                                {% endblock %}\n\n                                {% block ict_cart_details_modal_line_items_grid_grid_actions %}\n                                    <template #actions=\"{ item }\">\n                                        {% block sw_order_line_items_grid_grid_actions_show %}\n                                            <sw-context-menu-item v-if=\"item && item.id\"\n                                                                  icon=\"regular-eye\"\n                                                                  @click=\"navigateToProduct(item.id)\">\n                                                {% block sw_order_line_items_grid_grid_actions_show_label %}\n                                                    {{ $tc('ict-cart.detailsModal.contextMenuShowProduct') }}\n                                                {% endblock %}\n                                            </sw-context-menu-item>\n                                            <sw-context-menu-item v-else\n                                                                  :disabled=\"true\"\n                                                                  variant=\"danger\"\n                                                                  icon=\"regular-eye-slash\">\n                                                {% block sw_order_line_items_grid_grid_actions_unavailable_label %}\n                                                    {{ $tc('ict-cart.detailsModal.contextMenuUnavailable') }}\n                                                {% endblock %}\n                                            </sw-context-menu-item>\n                                        {% endblock %}\n                                    </template>\n                                {% endblock %}\n                            {% endblock %}\n                        </sw-data-grid>\n                    {% endblock %}\n                </sw-container>\n            {% endblock %}\n        </sw-modal>\n\n    {#for cart #}\n    <sw-modal\n            v-else\n            :title=\"$tc('ict-cart.detailsModal.cartModalTitle')\"\n            :isLoading=\"isLoading\"\n            @modal-close=\"onClose\">\n              \n        {% block ict_cart_details_modal_line_items_grid %}\n            <sw-container type=\"row\" class=\"ict-cart-details-line-items-grid\">\n\n                {% block ict_cart_details_modal_line_items_grid_grid %}\n                    <sw-data-grid :dataSource=\"items\"\n                                  :columns=\"getLineItemColumns\"\n                                  :fullPage=\"false\"\n                                  :showSettings=\"false\"\n                                  :showSelection=\"false\"\n                                  :showActions=\"true\"\n                                  :isLoading=\"isLoading\"\n                                  :allowColumnEdit=\"false\"\n                                  :allowInlineEdit=\"false\"\n                                  :compactMode=\"false\"\n                                  identifier=\"ict-cart-details-line-item-grid\"\n                                  class=\"ict-cart-details-line-items-grid__data-grid\">\n\n                        {% block ict_cart_details_modal_line_items_grid_grid_columns %}\n                            {% block ict_cart_details_modal_line_items_grid_grid_columns_label %}\n                                <template #column-label=\"{ item, isInlineEdit}\">\n                                    {% block ict_cart_details_modal_line_items_grid_grid_columns_label_content %}\n                                        <span>\n                                            {{ item.label }}\n                                        </span>\n                                    {% endblock %}\n                                </template>\n                            {% endblock %}\n\n                            {% block ict_cart_details_modal_line_items_grid_grid_columns_quantity %}\n                                <template #column-quantity=\"{ item, isInlineEdit}\">\n                                    {% block ict_cart_details_modal_line_items_grid_grid_columns_quantity_content %}\n                                        <span>\n                                            {{ item.quantity }}\n                                        </span>\n                                    {% endblock %}\n                                </template>\n                            {% endblock %}\n\n                            {% block ict_cart_details_modal_line_items_grid_grid_actions %}\n                                <template #actions=\"{ item }\">\n                                    {% block sw_order_line_items_grid_grid_actions_show %}\n                                        <sw-context-menu-item v-if=\"item.type === 'product' && item.referencedId\"\n                                                              icon=\"regular-eye\"\n                                                              @click=\"navigateToProduct(item.referencedId)\">\n                                            {% block sw_order_line_items_grid_grid_actions_show_label %}\n                                                {{ $tc('ict-cart.detailsModal.contextMenuShowProduct') }}\n                                            {% endblock %}\n                                        </sw-context-menu-item>\n\n                                        <sw-context-menu-item v-else\n                                                              :disabled=\"true\"\n                                                              variant=\"danger\"\n                                                              icon=\"regular-eye-slash\">\n                                            {% block sw_order_line_items_grid_grid_actions_unavailable_label %}\n                                                {{ $tc('ict-cart.detailsModal.contextMenuUnavailable') }}\n                                            {% endblock %}\n                                        </sw-context-menu-item>\n                                    {% endblock %}\n                                </template>\n                            {% endblock %}  \n                        {% endblock %}\n                    </sw-data-grid>\n                {% endblock %}\n\n            </sw-container>\n        {% endblock %}\n        \n    </sw-modal>\n{% endblock %}";