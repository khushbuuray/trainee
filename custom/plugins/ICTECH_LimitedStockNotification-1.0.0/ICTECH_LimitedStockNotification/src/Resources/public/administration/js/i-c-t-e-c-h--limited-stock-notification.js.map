export default "{% block ict_cart_list %}\n    <sw-page class=\"ict-cart-list\">\n        {% block ict_cart_list_smart_bar_header %}\n            <template #smart-bar-header>\n                {% block ict_cart_list_smart_bar_header_title %}\n                    <span class=\"ict-cart-smart-bar-header-title\">\n                        {% block ict_cart_list_smart_bar_header_title_text %}\n                            {{ $tc('ict-cart.general.listTitle') }}\n                        {% endblock %}\n                    </span>\n                {% endblock %}\n            </template>\n        {% endblock %}\n\n        <template #content>\n            {% block ict_cart_list_content %}\n                <div class=\"ict-cart-list__content\">\n                    {% block ict_cart_list_grid %}\n                        <sw-entity-listing v-if=\"entities\"\n                                           :items=\"entities\"\n                                           :columns=\"columns\"\n                                           :repository=\"repository\"\n                                           :showSelection=\"true\"\n                                           :isLoading=\"isLoading\"\n                                           @update-records=\"updateTotal\">\n\n                            {% block  ict_cart_list_content_column_lastMailSendAt %}        \n                                <template slot=\"column-lastMailSendAt\" slot-scope=\"{ item }\">\n                                    <span v-if=\"item.lastMailSendAt\">\n                                        {{ item.lastMailSendAt | date({hour: '2-digit', minute: '2-digit', second: '2-digit'}) }}\n                                    </span>\n                                    <span v-else>\n                                    {{ $tc('ict-cart.list.placeholders.lastMailSendAtPlaceholder') }}\n                                    </span>\n                                </template>\n                            {% endblock %}\n\n                            {% block  ict_cart_list_content_column_createdAt %}\n                                <template slot=\"column-createdAt\" slot-scope=\"{ item }\">\n                                    {{ item.createdAt | date({hour: '2-digit', minute: '2-digit', second: '2-digit'}) }}\n                                </template>\n                            {% endblock %}\n\n                            {% block  ict_cart_list_content_column_updatedAt %}\n                                <template slot=\"column-updatedAt\" slot-scope=\"{ item }\">\n                                    {{ item.updatedAt | date({hour: '2-digit', minute: '2-digit', second: '2-digit'}) }}\n                                </template>\n                            {% endblock %}\n\n                            {% block  ict_cart_list_content_column_wishlistId %}\n                                <template slot=\"column-wishlistId\" slot-scope=\"{ item }\">\n                                    {{ item.wishlistId }}\n                                </template>\n                            {% endblock %}\n\n                            {% block  ict_cart_list_content_more_actions %}    \n                                <template slot=\"more-actions\" slot-scope=\"{ item }\">\n                                    <sw-context-menu-item @click=\"onOpenDetailModel(item)\"\n                                                        :disabled=\"!item\"\n                                                        class=\"sw-entity-listing__context-menu-edit-open-details\">\n                                        {{ $tc('ict-cart.contextActions.openDetails') }}\n                                    </sw-context-menu-item>\n                                </template>\n                            {% endblock %}\n                        </sw-entity-listing>\n                    {% endblock %}\n\n                    {% block ict_cart_details_modal %}\n                        <ict-cart-details-modal v-if=\"ictCartDetailsModalOpened\"\n                                                :ict-cart=\"ictCartDetailCart\"\n                                                :isLoading=\"isLoading\"\n                                                :onClose=\"onCloseIctCartDetailsModal\">\n                        </ict-cart-details-modal>\n                    {% endblock %}\n\n                    {% block ict_cart_list_empty_state %}\n                        <sw-empty-state v-if=\"!isLoading && !total\" \n                                        :title=\"$tc('ict-cart.list.messageEmpty')\">\n                        </sw-empty-state>\n                    {% endblock %}\n                </div>\n            {% endblock %}\n        </template>\n\n        {% block ict_cart_list_sidebar %}\n            <template #sidebar>\n                <sw-sidebar>\n                    {% block ict_cart_list_sidebar_refresh %}\n                        <sw-sidebar-item\n                                icon=\"regular-undo\"\n                                :title=\"$tc('ict-cart.general.titleSidebarItemRefresh')\"\n                                @click=\"onRefresh\">\n                        </sw-sidebar-item>\n                    {% endblock %}\n                </sw-sidebar>\n            </template>\n        {% endblock %}\n    </sw-page>\n{% endblock %}\n";