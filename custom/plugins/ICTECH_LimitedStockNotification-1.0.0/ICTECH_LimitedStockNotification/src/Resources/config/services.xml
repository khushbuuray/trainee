<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <!--Entity Definition-->
        <service id="ICTECH_LimitedStockNotification\Core\Content\IctCartWishlist\IctCartWishlistDefinition">
            <tag name="shopware.entity.definition" entity="ict_cart_wishlist" />
        </service>

        <service id="ICTECH_LimitedStockNotification\Core\Content\IctCartWishlistProduct\IctCartWishlistProductDefinition">
            <tag name="shopware.entity.definition" entity="ict_cart_wishlist_product" />
        </service>

        <service id="ICTECH_LimitedStockNotification\Core\Content\Extension\ProductExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="ICTECH_LimitedStockNotification\Core\Content\Extension\CustomerExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="ICTECH_LimitedStockNotification\Core\Content\Extension\SalesChannelExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="ICTECH_LimitedStockNotification\Service\EmailService" public="true">
            <argument type="service" id="Shopware\Core\Content\Mail\Service\MailService"/>
            <argument type="service" id="mail_template.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="ict_cart_wishlist_product.repository"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
            <argument type="service" id="language.repository"/>
        </service>

        <service id="ICTECH_LimitedStockNotification\Storefront\Subscriber\DataSubscriber">
            <argument type="service" id="ict_cart_wishlist.repository" />
            <argument type="service" id="request_stack" />
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
                 <tag name="kernel.event_subscriber"/>
        </service>

        <service id="ICTECH_LimitedStockNotification\Storefront\Subscriber\ProductStatesChangedSubscriber">
            <argument type="service" id="product.repository" />
            <argument type="service" id="ict_cart_wishlist_product.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
                  <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Controller -->
        <service id="ICTECH_LimitedStockNotification\Storefront\Controller\AddWishlistController"
                 decorates="Shopware\Storefront\Controller\WishlistController" public="true">
            <argument type="service" id="Shopware\Storefront\Page\Wishlist\WishlistPageLoader"/>
            <argument type="service" id="Shopware\Core\Checkout\Customer\SalesChannel\LoadWishlistRoute"/>
            <argument type="service" id="Shopware\Core\Checkout\Customer\SalesChannel\AddWishlistProductRoute"/>
            <argument type="service" id="Shopware\Core\Checkout\Customer\SalesChannel\RemoveWishlistProductRoute"/>
            <argument type="service" id="Shopware\Core\Checkout\Customer\SalesChannel\MergeWishlistProductRoute"/>
            <argument type="service" id="Shopware\Storefront\Page\Wishlist\GuestWishlistPageLoader"/>
            <argument type="service" id="Shopware\Storefront\Pagelet\Wishlist\GuestWishlistPageletLoader"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="customer_wishlist.repository"/>
            <argument type="service" id="ict_cart_wishlist.repository" />
                <call method="setContainer">
                    <argument type="service" id="service_container"/>
                </call>
                <call method="setTwig">
                    <argument type="service" id="twig"/>
                </call>
                <tag name="controller.service_arguments" />
        </service>

        <service id="ICTECH_LimitedStockNotification\Storefront\Controller\CartWishlistEmailController">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="ict_cart_wishlist.repository" />
            <argument type="service" id="ict_cart_wishlist_product.repository"/>
            <argument type="service" id="ICTECH_LimitedStockNotification\Service\EmailService"/>
            <argument type="service" id="customer.repository" />
            <argument type="service" id="sales_channel.repository"/>
                <call method="setContainer">
                    <argument type="service" id="service_container"/>
                </call>
                <tag name="controller.service_arguments" />
        </service>

        <!-- Scheduled task-->
        <service id="ICTECH_LimitedStockNotification\ScheduledTask\CartWishlistTask">
            <tag name="shopware.scheduled.task"/>
        </service>
        <service id="ICTECH_LimitedStockNotification\ScheduledTask\CartWishlistTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="ICTECH_LimitedStockNotification\Storefront\Controller\CartWishlistEmailController"/>
                 <tag name="messenger.message_handler"/>
        </service>

    </services>
</container>