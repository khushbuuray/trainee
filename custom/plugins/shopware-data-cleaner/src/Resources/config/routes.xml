<?xml version="1.0" encoding="UTF-8" ?>
<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing
        https://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="api.ict_data_cleaner.preview" path="/api/v{version}/ict-data-cleaner/preview" methods="POST">
        <default key="_controller">IctDataCleanerPro\Controller\Api\CleanupController::preview</default>
        <default key="_routeScope">{"api"}</default>
    </route>

    <route id="api.ict_data_cleaner.cleanup" path="/api/v{version}/ict-data-cleaner/cleanup" methods="POST">
        <default key="_controller">IctDataCleanerPro\Controller\Api\CleanupController::cleanup</default>
        <default key="_routeScope">{"api"}</default>
    </route>

    <route id="api.ict_data_cleaner.logs" path="/api/v{version}/ict-data-cleaner/logs" methods="GET">
        <default key="_controller">IctDataCleanerPro\Controller\Api\CleanupController::logs</default>
        <default key="_routeScope">{"api"}</default>
    </route>
</routes>
