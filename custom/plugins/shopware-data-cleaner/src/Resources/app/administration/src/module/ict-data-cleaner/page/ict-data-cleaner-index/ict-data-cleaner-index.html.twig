{# 
 {% block ict_data_cleaner_index %}

<template>
    <sw-page class="ict-data-cleaner-index">
    {% block sw_ict_data_cleaner_header %}
        <template #smart-bar-header>
            <h2>{{ $tc('ict-data-cleaner.general.title') }}</h2>
        </template>
    {% endblock %}
      
    {% block sw_ict_data_cleaner_content %}
    <template #content>
        <sw-card-view>
    {% block sw_ict_data_cleaner_content_tabs %}

        <sw-tabs>
            <!-- General Settings Tab -->
            <sw-tabs-item
                :active="activeTab === 'products'"
                @click="activeTab = 'products'"
                :title="$tc('ict-data-cleaner.tabs.products')"
            >
                {{ $tc('ict-data-cleaner.tabs.products') }}
            </sw-tabs-item>

            <!-- Preview Tab -->
            <sw-tabs-item
                :active="activeTab === 'customers'"
                @click="activeTab = 'customers'"
                :title="$tc('ict-data-cleaner.tabs.customers')"
            >
                {{ $tc('ict-data-cleaner.tabs.customers') }}
            </sw-tabs-item>

              <!-- Carts Tab -->
            <sw-tabs-item
                :active="activeTab === 'carts'"
                @click="activeTab = 'carts'"
                :title="$tc('ict-data-cleaner.tabs.carts')"
            >
                {{ $tc('ict-data-cleaner.tabs.carts') }}
            </sw-tabs-item>
        </sw-tabs>
    {% endblock %}   

        <sw-card title="Products & Variants" :isLoading="isLoading">
            <sw-container columns="1fr 1fr" gap="16px">

                <sw-text-field
                    label="Remove products not sold in months"
                    v-model="productSettings['IctDataCleaner.config.productCleanupMonthsNotSold']"
                    placeholder="6"
                    type="number"
                    :min="1"
                    :max="120"
                />

                <sw-switch-field
                    label="Delete products never sold"
                    v-model="productSettings['IctDataCleaner.config.productCleanupDeleteNeverSold']"
                />

                <sw-text-field
                    label="Remove inactive products older than months"
                    v-model="productSettings['IctDataCleaner.config.productCleanupMonthsDisabled']"
                    placeholder="6"
                    type="number"
                    :min="1"
                    :max="120"
                />

                <sw-text-field
                    label="Remove variants with zero stock and no sales in months"
                    v-model="productSettings['IctDataCleaner.config.productVariantCleanupZeroStockMonths']"
                    placeholder="6"
                    type="number"
                    :min="1"
                    :max="120"
                />
            </sw-container>

            <sw-button @click="previewAction" variant="primary" class="mt-4">
                Preview Cleanup
            </sw-button>
        </sw-card> 
        </sw-card-view>
    </template>
    {% endblock %}
              <!-- Modal section -->

    <sw-modal
    title="Preview Cleanup"
    :visible="true"
    size="large"
    @modal-close="closeModal"
>
    <template #content>
        <ul>
            <li><strong>Remove products not sold in months:</strong> {{ config['IctDataCleaner.config.productCleanupMonthsNotSold'] }}</li>
            <li><strong>Delete products never sold:</strong> {{ config['IctDataCleaner.config.productCleanupDeleteNeverSold'] ? 'Yes' : 'No' }}</li>
            <li><strong>Remove inactive products older than months:</strong> {{ config['IctDataCleaner.config.productCleanupMonthsDisabled'] }}</li>
            <li><strong>Remove variants with zero stock and no sales in months:</strong> {{ config['IctDataCleaner.config.productVariantCleanupZeroStockMonths'] }}</li>
        </ul>
    </template>

    <template #footer>
        <sw-button variant="ghost" @click="closeModal">Cancel</sw-button>
        <sw-button variant="primary" @click="confirmCleanup">Run Cleanup</sw-button>
    </template>
</sw-modal>



    </sw-page>
</template>
{% endblock %} #}
{% block ict_data_cleaner_index %}
<template>
    <sw-page class="ict-data-cleaner-index">

        {% block sw_ict_data_cleaner_header %}
        <template #smart-bar-header>
            <h2>{{ $tc('ict-data-cleaner.general.title') }}</h2>
        </template>
        {% endblock %}

        {% block sw_ict_data_cleaner_content %}
        <template #content>
            <sw-card-view>

                {% block sw_ict_data_cleaner_content_tabs %}
                <sw-tabs>
                    <sw-tabs-item
                        :active="activeTab === 'products'"
                        @click="activeTab = 'products'"
                        :title="$tc('ict-data-cleaner.tabs.products')"
                    >
                        {{ $tc('ict-data-cleaner.tabs.products') }}
                    </sw-tabs-item>

                    <sw-tabs-item
                        :active="activeTab === 'customers'"
                        @click="activeTab = 'customers'"
                        :title="$tc('ict-data-cleaner.tabs.customers')"
                    >
                        {{ $tc('ict-data-cleaner.tabs.customers') }}
                    </sw-tabs-item>

                    <sw-tabs-item
                        :active="activeTab === 'carts'"
                        @click="activeTab = 'carts'"
                        :title="$tc('ict-data-cleaner.tabs.carts')"
                    >
                        {{ $tc('ict-data-cleaner.tabs.carts') }}
                    </sw-tabs-item>
                </sw-tabs>
                {% endblock %}

                <sw-card title="Products & Variants" :isLoading="isLoading">
                    <sw-container gap="10px">

                        <!-- Remove products not sold in months -->
                        <div class="field-block">
                            <div class="field-header">
                                <label class="field-label">Remove products not sold in months</label>
                                <sw-button
                                    @click="previewAction('productCleanupMonthsNotSold')"
                                    size="small"
                                    variant="primary"
                                >
                                    Preview
                                </sw-button>
                            </div>
                            <sw-text-field
                                v-model="productSettings['IctDataCleaner.config.productCleanupMonthsNotSold']"
                                placeholder="6"
                                type="number"
                                :min="1"
                                :max="120"
                            />
                        </div>

                        <!-- Delete products never sold -->
                        <div class="field-block">
                            <div class="field-header">
                                <label class="field-label">Delete products never sold</label>
                                <sw-button
                                    @click="previewAction('productCleanupDeleteNeverSold')"
                                    size="small"
                                    variant="primary"
                                >
                                    Preview
                                </sw-button>
                            </div>
                            <sw-switch-field
                                v-model="productSettings['IctDataCleaner.config.productCleanupDeleteNeverSold']"
                            />
                        </div>

                        <!-- Remove inactive products older than months -->
                        <div class="field-block">
                            <div class="field-header">
                                <label class="field-label">Remove inactive products older than months</label>
                                <sw-button
                                    @click="previewAction('productCleanupMonthsDisabled')"
                                    size="small"
                                    variant="primary"
                                >
                                    Preview
                                </sw-button>
                            </div>
                            <sw-text-field
                                v-model="productSettings['IctDataCleaner.config.productCleanupMonthsDisabled']"
                                placeholder="6"
                                type="number"
                                :min="1"
                                :max="120"
                            />
                        </div>

                        <!-- Remove variants with zero stock and no sales in months -->
                        <div class="field-block">
                            <div class="field-header">
                                <label class="field-label">Remove variants with zero stock and no sales in months</label>
                                <sw-button
                                    @click="previewAction('productVariantCleanupZeroStockMonths')"
                                    size="small"
                                    variant="primary"
                                >
                                    Preview
                                </sw-button>
                            </div>
                            <sw-text-field
                                v-model="productSettings['IctDataCleaner.config.productVariantCleanupZeroStockMonths']"
                                placeholder="6"
                                type="number"
                                :min="1"
                                :max="120"
                            />
                        </div>

                    </sw-container>
                </sw-card>

            </sw-card-view>
        </template>
        {% endblock %}

    </sw-page>
</template>
{% endblock %}
