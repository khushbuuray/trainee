{% block ict_data_cleaner_index %}
<template>
    <sw-page class="ict-data-cleaner-index">

        {% block sw_ict_data_cleaner_header %}
        <template #smart-bar-header>
            <h2>{{ $tc('ict-data-cleaner.general.title') }}</h2>
        </template>
        {% endblock %}

        {% block sw_ict_data_cleaner_content %}
        <template #content>
            <sw-card-view>

                {% block sw_ict_data_cleaner_content_tabs %}
                <sw-tabs>
                    <sw-tabs-item
                        :active="activeTab === 'products'"
                        @click="activeTab = 'products'"
                        :title="$tc('ict-data-cleaner.tabs.products')"
                    >
                        {{ $tc('ict-data-cleaner.tabs.products') }}
                    </sw-tabs-item>

                    <sw-tabs-item
                        :active="activeTab === 'customers'"
                        @click="activeTab = 'customers'"
                        :title="$tc('ict-data-cleaner.tabs.customers')"
                    >
                        {{ $tc('ict-data-cleaner.tabs.customers') }}
                    </sw-tabs-item>

                    <sw-tabs-item
                        :active="activeTab === 'carts'"
                        @click="activeTab = 'carts'"
                        :title="$tc('ict-data-cleaner.tabs.carts')"
                    >
                        {{ $tc('ict-data-cleaner.tabs.carts') }}
                    </sw-tabs-item>
                </sw-tabs>
                {% endblock %}

                <sw-card title="Products & Variants" :isLoading="isLoading">
                    <sw-container gap="10px">

                        <!-- Remove products not sold in months -->
                        <div class="field-block">
                            <div class="field-header">
                                <label class="field-label">Remove products not sold in months</label>
                                <sw-button
                                    @click="previewAction('productCleanup.monthsNotSold')"
                                    size="small"
                                    variant="primary"
                                >
                                    Preview
                                </sw-button>
                            </div>
                            <sw-text-field
                                v-model="productSettings['IctDataCleaner.config.productCleanup.monthsNotSold']"
                                placeholder="6"
                                type="number"
                                :min="1"
                                :max="120"
                                :disabled="true"
                            />
                        </div>

                        <!-- Delete products never sold -->
                        <div class="field-block">
                            <div class="field-header">
                                <label class="field-label">Delete products never sold</label>
                                <sw-button
                                    @click="previewAction('productCleanup.deleteNeverSold')"
                                    size="small"
                                    variant="primary"
                                >
                                    Preview
                                </sw-button>
                            </div>
                            <sw-switch-field
                                v-model="productSettings['IctDataCleaner.config.productCleanup.deleteNeverSold']"
                            />
                        </div>

                        <!-- Remove inactive products older than months -->
                        <div class="field-block">
                            <div class="field-header">
                                <label class="field-label">Remove inactive products older than months</label>
                                <sw-button
                                    @click="previewAction('productCleanup.monthsDisabled')"
                                    size="small"
                                    variant="primary"
                                >
                                    Preview
                                </sw-button>
                            </div>
                            <sw-text-field
                                v-model="productSettings['IctDataCleaner.config.productCleanup.monthsDisabled']"
                                placeholder="6"
                                type="number"
                                :min="1"
                                :max="120"
                                :disabled="true"
                            />
                        </div>

                        <!-- Remove variants with zero stock and no sales in months -->
                        <div class="field-block">
                            <div class="field-header">
                                <label class="field-label">Remove variants with zero stock and no sales in months</label>
                                <sw-button
                                    @click="previewAction('productVariantCleanupZeroStockMonths')"
                                    size="small"
                                    variant="primary"
                                >
                                    Preview
                                </sw-button>
                            </div>
                            <sw-text-field
                                v-model="productSettings['IctDataCleaner.config.productVariantCleanupZeroStockMonths']"
                                placeholder="6"
                                type="number"
                                :min="1"
                                :max="120"
                                :disabled="true"
                            />
                        </div>

                    </sw-container>
                </sw-card>

                {% block ict_data_cleaner_index_modal %}
                <sw-modal
                    v-if="showPreviewModal"
                    class="ict-data-cleaner-preview-modal"
                    size="large"
                    :title="$tc('ict-data-cleaner.tabs.previewTitle')"
                    @modal-close="showPreviewModal = false"
                >
                    <template v-if="gridReady && paginatedProducts && paginatedProducts.length">
                        <sw-data-grid
                            v-if="gridReady"
                            ref="previewGrid"
                            :key="gridKey"
                            :dataSource="paginatedProducts"
                            :columns="[
                                { property: 'name', label: 'Name', rawData: true },
                                { property: 'product_number', label: 'Product Number' }
                            ]"
                            :selectionMode="'multi'"
                            :selection="selectedPreviewProducts"
                            :showSelection="true"
                            @selection-change="onProductSelectionChange"
                        >
                            <template #name="{ item }">
                                <router-link
                                    :to="{ name: 'sw.product.detail', params: { id: item.id } }"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    {{ item.name || 'N/A' }}
                                </router-link>
                            </template>

                            <template #product_number="{ item }">
                                <span>{{ item.product_number || 'N/A' }}</span>
                            </template>
                        </sw-data-grid>

                        <div class="sw-grid__total-count">
                            <strong>Total Products Never Sold: </strong>
                            {{ previewData.items.products_never_sold.count }}
                        </div>
                    </template>

                    <template v-else>
                        <p>{{ $tc('ict-data-cleaner.preview.loading') }}</p>
                    </template>

                    <sw-pagination
                        v-if="!isLoading"
                        class="sw-cms-list__list-pagination"
                        :page="currentPage"
                        :limit="limit"
                        :total="total"
                        :steps="[9]"
                        @page-change="onPageChange"
                    />

                    <template #modal-footer>
                        <sw-button
                            variant="primary"
                            size="small"
                            @click="showPreviewModal = false"
                        >
                            {{ $tc('global.default.close') }}
                        </sw-button>

                        <sw-button
                            variant="primary"
                            size="small"
                            @click="removeSelectedProducts"
                        >
                            Remove
                        </sw-button>
                    </template>
                </sw-modal>
                {% endblock %}

            </sw-card-view>
        </template>
        {% endblock %}

    </sw-page>
</template>
{% endblock %}
