export default "{% block zeobv_bundle_connections_modal %}\n    <sw-modal :title=\"$tc('sw-order.zeobv-bundle-connections.modal.modalTitle')\"\n              :isLoading=\"isLoading\"\n              @modal-close=\"onClose\">\n        {% block zeobv_bundle_connections_modal_line_items_grid %}\n            <sw-container type=\"row\" class=\"zeobv-bundle-connections-line-items-grid\">\n\n                {% block zeobv_bundle_connections_modal_line_items_grid_grid %}\n                    <sw-data-grid \n                        :dataSource=\"item.children\"\n                        :columns=\"getLineItemColumns\"\n                        :fullPage=\"false\"\n                        :showSettings=\"false\"\n                        :showSelection=\"false\"\n                        :showActions=\"true\"\n                        :isLoading=\"isLoading\"\n                        :allowColumnEdit=\"false\"\n                        :allowInlineEdit=\"false\"\n                        :compactMode=\"false\"\n                        identifier=\"zeobv-bundle-connections-line-item-grid\"\n                        class=\"zeobv-bundle-connections-line-items-grid__data-grid\"\n                    >\n                        {% block zeobv_bundle_connections_modal_line_items_grid_grid_columns %}\n                            {% block zeobv_bundle_connections_modal_line_items_grid_grid_columns_label %}\n                                <template #column-label=\"{ item, isInlineEdit}\">\n                                    {% block zeobv_bundle_connections_modal_line_items_grid_grid_columns_label_content %}\n                                        <template>\n                                            {{ item.label }}\n                                        </template>\n                                    {% endblock %}\n                                </template>\n                            {% endblock %}\n\n                            {% block zeobv_bundle_connections_modal_line_items_grid_grid_columns_unit_price %}\n                                <template #column-comment=\"{ item, isInlineEdit}\">\n                                    {% block zeobv_bundle_connections_modal_line_items_grid_grid_columns_comment_content %}\n                                        <template>\n                                            {{ item.payload.comment }}\n                                        </template>\n                                    {% endblock %}\n                                </template>\n                            {% endblock %}\n\n                            {% block zeobv_bundle_connections_modal_line_items_grid_grid_columns_unit_price %}\n                                <template #column-unitPrice=\"{ item, isInlineEdit}\">\n                                    {% block zeobv_bundle_connections_modal_line_items_grid_grid_columns_unit_price_content %}\n                                        <template>\n                                            {{ item.unitPrice.toFixed(2) | currency(order.currency.shortName) }}\n                                        </template>\n                                    {% endblock %}\n                                </template>\n                            {% endblock %}\n\n                            {% block zeobv_bundle_connections_modal_line_items_grid_grid_columns_unit_price %}\n                                <template #column-quantity=\"{ item, isInlineEdit}\">\n                                    {% block zeobv_bundle_connections_modal_line_items_grid_grid_columns_quantity_content %}\n                                        <template>\n                                            {{ item.quantity }}\n                                        </template>\n                                    {% endblock %}\n                                </template>\n                            {% endblock %}\n\n                            {% block zeobv_bundle_connections_modal_line_items_grid_grid_columns_totalPrice %}\n                                <template #column-totalPrice=\"{ item, isInlineEdit}\">\n                                    {% block zeobv_bundle_connections_modal_line_items_grid_grid_columns_totalPrice_content %}\n                                        <template>\n                                            {{ item.totalPrice.toFixed(2) | currency(order.currency.shortName) }}\n                                        </template>\n                                    {% endblock %}\n                                </template>\n                            {% endblock %}\n\n                            {% block zeobv_bundle_connections_modal_line_items_grid_grid_actions %}\n                                <template #actions=\"{ item }\">\n                                    {% block sw_order_line_items_grid_grid_actions_show %}\n                                        <sw-context-menu-item \n                                            icon=\"default-eye-open\"\n                                            @click=\"navigateToProduct(item.referencedId)\"\n                                        >\n                                            {% block sw_order_line_items_grid_grid_actions_show_label %}\n                                                {{ $tc('sw-order.detailBase.contextMenuShowProduct') }}\n                                            {% endblock %}\n                                        </sw-context-menu-item>\n                                    {% endblock %}\n                                </template>\n                            {% endblock %}\n                        {% endblock %}\n                    </sw-data-grid>\n                {% endblock %}\n            </sw-container>\n        {% endblock %}\n    </sw-modal>\n{% endblock %}\n";