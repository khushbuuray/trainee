export default "{% block sw_product_detail_base_category_card %}\n    {% parent %}\n    <sw-card v-if=\"!product.childCount\" :title=\"$tc('sw-product.detailBase.cardTitleBundleProducts')\" :isLoading=\"loading.product\">\n        <zeobv-bundle-product-connections-grid\n                :discount=\"zeobvBundleProductsDiscountPercentage\"\n                :loading=\"loading.product\"\n                :showDiscountField=\"showDiscountField\"\n                :product=\"product\"\n                :products-in-bundle=\"productsInBundle\"\n                :onAddNewRow=\"onAddNewRow\"\n                @item-delete=\"onItemDelete\"\n                @update:discount=\"onDiscountUpdated\"\n                @updated=\"onBundleConnectionsUpdated\"\n        >\n        </zeobv-bundle-product-connections-grid>\n\n        <div class=\"zeobv-bundle-product-connections-grid-switches\">\n            <sw-switch-field\n                v-if=\"showShowBundleProductsOnStorefrontSwitch\"\n                v-model=\"zeobvBundleProductsShowOnStorefront\"\n                class=\"zeobv-bundle-product-connections-grid-switch\"\n                :error=\"productExtensionsError\"\n                :label=\"$tc('sw-product.bundle.field.productBundleShowOnStorefrontSwitchLabel')\"\n            ></sw-switch-field>\n            \n            <sw-switch-field\n                v-if=\"showAllowItemSelectionSwitch\"\n                v-model=\"zeobvBundleProductsAllowItemSelection\"\n                class=\"zeobv-bundle-product-connections-grid-switch\"\n                :error=\"productExtensionsError\"\n                :label=\"$tc('sw-product.bundle.field.allowItemSelection')\"\n            ></sw-switch-field>\n\n            <sw-switch-field\n                v-if=\"showAllowQtySelectionSwitch\"\n                v-model=\"zeobvBundleProductsAllowQtySelection\"\n                class=\"zeobv-bundle-product-connections-grid-switch\"\n                :error=\"productExtensionsError\"\n                :label=\"$tc('sw-product.bundle.field.allowQtySelection')\"\n            ></sw-switch-field>\n\n            <sw-switch-field\n                v-if=\"showOfferBundleOptionallySwitch\"\n                v-model=\"zeobvBundleProductsOfferBundleOptionally\"\n                class=\"zeobv-bundle-product-connections-grid-switch\"\n                :error=\"productExtensionsError\"\n                :label=\"$tc('sw-product.bundle.field.offerBundleOptionally')\"\n            ></sw-switch-field>\n\n            <sw-switch-field\n                v-if=\"showShowItemPricesOnStorefrontSwitch\"\n                v-model=\"zeobvBundleProductsShowItemPricesOnStorefront\"\n                class=\"zeobv-bundle-product-connections-grid-switch\"\n                :error=\"productExtensionsError\"\n                :label=\"$tc('sw-product.bundle.field.productBundleShowItemPricesOnStorefrontSwitchLabel')\"\n            ></sw-switch-field>\n\n            <sw-switch-field\n                v-if=\"showShowTotalPriceOnStorefrontSwitch\"\n                v-model=\"zeobvBundleProductsShowItemsTotalPriceOnStorefront\"\n                class=\"zeobv-bundle-product-connections-grid-switch\"\n                :error=\"productExtensionsError\"\n                :label=\"$tc('sw-product.bundle.field.productBundleShowTotalItemPriceOnStorefrontSwitchLabel')\"\n            ></sw-switch-field>\n        </div>\n    </sw-card>\n{% endblock %}\n";