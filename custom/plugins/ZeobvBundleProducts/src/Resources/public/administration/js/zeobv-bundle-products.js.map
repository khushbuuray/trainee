export default "{% block zeobv_bundle_product_connections_grid %}\n    <sw-container type=\"row\" class=\"zeobv-bundle-product-connections-grid\">\n\n        {% block zeobv_bundle_product_connections_grid_actions %}\n            <sw-container\n                class=\"zeobv-bundle-product-connections-grid__actions-container\"\n                columns=\"1fr auto\"\n                gap=\"16px\"\n                v-show=\"editable\">\n                        \n                <sw-number-field\n                    v-if=\"showDiscountField\"\n                    class=\"zeobv-bundle-product-connections-grid-discount-percentage\"\n                    :value=\"discount\"\n                    numberType=\"int\"\n                    :min=\"0\"\n                    :placeholder=\"$tc('sw-product.bundle.field.productBundleDiscountPercentage')\"\n                    @change=\"onDiscountPercentageChanged\"\n                >\n                    <template #suffix>\n                        %\n                    </template>\n                </sw-number-field>\n\n                {% block zeobv_bundle_product_connections_grid_create_actions %}\n                    <div class=\"zeobv-bundle-product-connections-grid__btn-add\">\n                        {% block zeobv_bundle_product_connections_grid_add_product %}\n                            <sw-button\n                                class=\"zeobv-bundle-product-connections-grid__actions-container-add-product-btn\"\n                                variant=\"ghost\"\n                                size=\"small\"\n                                @click=\"onAddNewRow\">\n                                {{ $tc('sw-order.detailBase.buttonAddProduct') }}\n                            </sw-button>\n                        {% endblock %}\n                    </div>\n                {% endblock %}\n            </sw-container>\n        {% endblock %}\n\n        {% block zeobv_bundle_product_connections_grid_grid %}\n            <sw-data-grid\n                :loading=\"loading\"\n                :dataSource=\"bundleConnections\"\n                :columns=\"columns\"\n                :fullPage=\"false\"\n                :showSettings=\"true\"\n                :showSelection=\"editable\"\n                :showActions=\"true\"\n                :isLoading=\"isLoading\"\n                :allowColumnEdit=\"false\"\n                :allowInlineEdit=\"false\"\n                :compactMode=\"false\"\n                identifier=\"zeobv-bundle-product-connections-grid\"\n                class=\"zeobv-bundle-product-connections-grid__data-grid\"\n                @selection-change=\"onSelectionChanged\"\n                :isRecordEditable=\"(item) => true\">\n\n                {% block zeobv_bundle_product_connections_grid_grid_columns %}\n                    {% block zeobv_bundle_product_connections_grid_grid_columns_position %}\n                        <template #column-position=\"{ item, isInlineEdit }\">\n\n                            {% block zeobv_bundle_product_connections_grid_grid_columns_position %}\n                                <sw-data-grid-column-position\n                                        v-model=\"bundleConnections\"\n                                        :show-value=\"true\"\n                                        :item=\"item\"\n                                        :disabled=\"false\"\n                                        @position-changed=\"onPositionChanged\"\n                                ></sw-data-grid-column-position>\n                            {% endblock %}\n                        </template>\n                    {% endblock %}\n\n                    {% block zeobv_bundle_product_connections_grid_grid_columns_label %}\n                        <template #column-product=\"{ item, isInlineEdit}\">\n\n                            {% block zeobv_bundle_product_connections_grid_grid_columns_label %}\n                                <sw-entity-single-select\n                                    entity=\"product\"\n                                    :labelCallback=\"productSelectionLabel\"\n                                    :value=\"item.productId ? item.productId : ''\"\n                                    :context=\"context\"\n                                    :criteria=\"productSelectCriteria\"\n                                    @change=\"(value) => onProductSelected(item, value)\">\n                                </sw-entity-single-select>\n                            {% endblock %}\n                        </template>\n                    {% endblock %}\n\n                    {% block zeobv_bundle_product_connections_grid_grid_columns_quantity %}\n                        <template #column-quantity=\"{ item, isInlineEdit }\">\n\n                            {% block zeobv_bundle_product_connections_grid_grid_columns_quantity %}\n                                <sw-number-field\n                                    numberType=\"int\"\n                                    v-model=\"item.quantity\"\n                                    :min=\"1\"\n                                    size=\"small\"\n                                    placeholder=\"0\">\n                                </sw-number-field>\n                            {% endblock %}\n                        </template>\n                    {% endblock %}\n\n                    {% block zeobv_bundle_product_connections_grid_grid_columns_comment %}\n                        <template #column-comment=\"{ item, isInlineEdit }\">\n\n                            {% block zeobv_bundle_product_connections_grid_grid_columns_comment %}\n                                <sw-text-field\n                                    v-model=\"item.comment\"\n                                    size=\"small\">\n                                </sw-text-field>\n                            {% endblock %}\n                        </template>\n                    {% endblock %}\n\n                    {% block zeobv_bundle_product_connections_grid_grid_actions %}\n                        <template #actions=\"{ item, index }\">\n                            {% block zeobv_bundle_product_connections_grid_grid_actions_show %}\n                            <sw-context-menu-item\n                                icon=\"regular-eye-s\"\n                                :routerLink=\"{ name: 'sw.product.detail', params: { id: item.productId } }\">\n                                {% block zeobv_bundle_product_connections_grid_grid_actions_show_label %}\n                                    {{ $tc('sw-order.detailBase.contextMenuShowProduct') }}\n                                {% endblock %}\n                            </sw-context-menu-item>\n                            {% endblock %}\n                        </template>\n                    {% endblock %}\n\n                    {% block zeobv_bundle_product_connections_grid_bulk_actions %}\n                        <template #bulk>\n                            {% block zeobv_bundle_product_connections_grid_bulk_actions_delete %}\n                                <a class=\"link link-danger\" @click=\"onDeleteSelectedItems\">\n                                    {{ $tc('global.default.delete') }}\n                                </a>\n                            {% endblock %}\n                        </template>\n                    {% endblock %}\n                {% endblock %}\n            </sw-data-grid>\n        {% endblock %}\n    </sw-container>\n{% endblock %}\n";