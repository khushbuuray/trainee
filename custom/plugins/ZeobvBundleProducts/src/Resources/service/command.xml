<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Zeobv\BundleProducts\Command\Seed\BundleConnections">
            <argument type="service" id="product.repository" />
            <argument type="service" id="zeobv_product_bundle_connection.repository" />
            <tag name="console.command"/>
        </service>

        <service id="Zeobv\BundleProducts\Command\Sync\BundleStockSync">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Zeobv\BundleProducts\MessageBus\Handler\BundleStockUpdateHandler" />
            <argument type="service" id="pickware_erp_pickware_product.repository" on-invalid="null"/>
            <tag name="console.command"/>
        </service>
    </services>
</container>
