<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service 
            id="Zeobv\BundleProducts\Decorator\Core\Content\Product\DataAbstractionLayer\ProductIndexer"
            decorates="Shopware\Core\Content\Product\DataAbstractionLayer\ProductIndexer"
            decoration-inner-name="zeobv.bundle_products.decorator.core.content.product.data_abstraction_layer.product_indexer.inner"
        >
            <argument type="service" id="zeobv.bundle_products.decorator.core.content.product.data_abstraction_layer.product_indexer.inner"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\Indexing\InheritanceUpdater"/>
            <argument type="service" id="Zeobv\BundleProducts\Core\Subscriber\BundleProductStockUpdater"/>
        </service>

        <service 
            id="Zeobv\BundleProducts\Decorator\CbaxOrderConverterDecorator"
            decorates="Cbax\ModulOrderImportEbay\Components\OrderConverter"
            decoration-inner-name="zeobv.bundle_products.components.core.order.converter.decorator.inner"
            decoration-on-invalid="ignore"
        >
            <argument type="service" id="zeobv.bundle_products.components.core.order.converter.decorator.inner"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\LineItemFactoryHandler\ProductLineItemFactory"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Processor"/>
        </service>

        <service 
            id="Zeobv\BundleProducts\Decorator\CartItemAddRouteDecorator"
            decorates="Shopware\Core\Checkout\Cart\SalesChannel\CartItemAddRoute"
        >
            <argument type="service" id="Zeobv\BundleProducts\Decorator\CartItemAddRouteDecorator.inner"/>
            <argument type="service" id="request_stack"/>
        </service>

        <service id="Zeobv\BundleProducts\Decorator\MailServiceDecorator"
                 decorates="Shopware\Core\Content\Mail\Service\MailService">
            <argument type="service" id="Zeobv\BundleProducts\Decorator\MailServiceDecorator.inner"/>
            <argument type="service" id="zeobv.bundle_products.service.config_service" />
        </service>

        <service
                id="Zeobv\BundleProducts\Decorator\ParcelHydratorDecorator"
                decorates="Pickware\ShippingBundle\ParcelHydration\ParcelHydrator"
                decoration-on-invalid="ignore"
        >
            <argument type="service" id="Zeobv\BundleProducts\Decorator\ParcelHydratorDecorator.inner"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Pickware\DalBundle\EntityManager"/>
            <argument type="service" id="Pickware\DalBundle\ContextFactory"/>
            <argument type="service" id="Pickware\ShippingBundle\Notifications\NotificationService"/>
            <argument type="service" id="zeobv.bundle_products.service.config_service" />
        </service>
    </services>
</container>
