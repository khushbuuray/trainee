{% sw_extends '@Storefront/storefront/component/checkout/offcanvas-item.html.twig' %}

{% set isBundleProduct = lineItem.children.count > 0 and lineItem.type is same as('product') %}
{% set isBundleLineItem = lineItem.type is same as("bundle_product_item") %}
{% set hideBundleCartAndCheckout = config('ZeobvBundleProducts.config.hideBundleInformationInShoppingCartAndCheckout') %}
{% set hideBundleChildren = lineItem.payload.zeobvHideBundleProductChildrenInStorefront or hideBundleCartAndCheckout %}

{% block component_offcanvas_cart_item_container %}
    {% if isBundleLineItem and hideBundleChildren %}
        {# hide #}
    {% elseif isBundleProduct and hideBundleChildren %}
        {% set isNested = false %}
        {{ parent() }}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block component_offcanvas_product_image_inner %}
    {% if isBundleProduct %}
        <div class="cart-item-img">
            <a href="{{ seoUrl('frontend.detail.page', {'productId': referencedId}) }}"
               class="cart-item-img-link"
               title="{{ label }}">
                {% if lineItem.cover.url %}
                    {% sw_thumbnails 'cart-item-img-thumbnails' with {
                        media: lineItem.cover,
                        sizes: {
                            'default': '100px'
                        },
                        attributes: {
                            'class': 'img-fluid cart-item-img-source',
                            'alt': label,
                            'title': label
                        }
                    } %}
                {% else %}
                    {% sw_icon 'placeholder' style {
                        'size': 'fluid'
                    } %}
                {% endif %}
            </a>
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block component_offcanvas_product_label %}
    {% if isBundleLineItem %}
        <div class="cart-item-details">
            <a href="{{ seoUrl('frontend.detail.page', {'productId': referencedId}) }}"
               class="cart-item-label"
               title="{{ label }}">
                {{ lineItem.quantity }}{{ "checkout.quantityTimes"|trans|sw_sanitize }} {{ label|u.truncate(60, '...', false) }}
            </a>
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block component_offcanvas_product_quantity %}
    {% if isBundleLineItem %}
        <div class="cart-quantity-price"></div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block component_offcanvas_children %}
    {% if hideBundleChildren == false %}
        {{ parent() }}
    {% endif %}
{% endblock %}
